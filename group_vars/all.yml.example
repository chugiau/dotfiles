---
# Dotfiles Configuration
#
# Copy this file to all.yml and customize for your setup:
#   cp all.yml.example all.yml

# Which roles to run (comment out to skip)
default_roles:
  - homebrew        # Install/ensure Homebrew (skip if you prefer system PM only)
  - core            # git, git-lfs, jq, openssh, gpg
  - zsh             # zsh + oh-my-zsh + powerlevel10k
  - cli_tools       # bat, eza, lazygit, glow
  - neovim          # neovim 0.11+ + NvChad starter
  - dotfiles        # Symlinks + alias fixups

# Package manager preference for dev tools on Linux
# "brew" = Homebrew (recommended, consistent cross-platform)
# "system" = apt/pacman/dnf (use distro packages where possible)
pm_preference: brew

# Dotfiles source directory
dotfiles_dir: "{{ ansible_facts.env.HOME }}/.dotfiles"

# Neovim minimum version
neovim_min_version: "0.11"

# Neovim config repo (fork NvChad/starter, customize, put your repo here)
# nvim_repo: "https://github.com/<you>/nvim-config.git"

# Excluded roles (override without editing default_roles)
exclude_roles: []
