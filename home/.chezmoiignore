# Files inside home/ that chezmoi should NOT apply to the destination.
#
# Everything in home/ is a chezmoi source by convention; this file is the
# escape hatch for anything that lives here for documentation or tooling
# but must not land in the user's $HOME.

{{ if eq .chezmoi.os "windows" -}}
# Native Windows uses PowerShell run scripts and profile wiring. Keep the
# Unix shell runtime out of a Windows home directory and avoid executing
# POSIX run scripts during `chezmoi apply`.
.zshenv
.zprofile
.zshrc
.tmux.conf
.gnupg/
.config/dotfiles/modules/
.config/dotfiles/bin/
10-system-packages.sh
10-mise-install.sh
15-neovim.sh
16-completions.sh
20-ohmyzsh.sh
30-nvchad.sh
40-git-hooks.sh
41-ssh-config-auth.sh
42-gpg-agent-auth.sh
50-default-shell.sh
60-claude-statusline.sh
61-claude-env.sh
62-claude-security.sh
63-codex-security.sh
{{ else -}}
# Non-Windows hosts keep the zsh/POSIX flow and ignore native Windows
# PowerShell startup files and Windows-only run scripts.
Documents/PowerShell/
.config/dotfiles/powershell/
05-windows-packages.ps1
11-mise-windows.ps1
{{ end -}}
