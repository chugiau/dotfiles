#!/bin/sh
# Install Neovim from the upstream pre-built tarball into /opt and
# symlink the binary into /usr/local/bin/nvim.
#
# Why not mise: mise shims live under ~/.local/share/mise/shims, only on
# PATH for the interactive zsh rc that runs `mise activate`. sudo /
# sudoedit / cron / root logins use sudo's secure_path
# (/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin) and
# never see the shim, so $EDITOR=nvim breaks for any privileged editor
# session. Dropping the binary into /usr/local/bin fixes all of them
# without touching anyone's PATH.
#
# Source: https://neovim.io/doc/install/  (pre-built archives section)
#
# To upgrade: bump NVIM_VERSION below. The run_onchange_ content hash
# shifts and chezmoi re-runs this script on the next `apply`.

set -eu

NVIM_VERSION="v0.12.1"

log()  { printf '\033[0;34m[neovim]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[neovim]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[0;31m[neovim]\033[0m %s\n' "$*" >&2; exit 1; }

need_sudo() {
    if [ "$(id -u)" -eq 0 ]; then
        "$@"
    elif command -v sudo >/dev/null 2>&1; then
        sudo "$@"
    else
        die "Need root or sudo to run: $*"
    fi
}

# ── Resolve host triple ────────────────────────────────────────────────────
case "$(uname -s)" in
    Linux)  os=linux ;;
    Darwin) os=macos ;;
    *)      die "unsupported OS: $(uname -s)" ;;
esac

case "$(uname -m)" in
    x86_64|amd64)   arch=x86_64 ;;
    aarch64|arm64)  arch=arm64 ;;
    *)              die "unsupported arch: $(uname -m)" ;;
esac

asset="nvim-${os}-${arch}.tar.gz"
url="https://github.com/neovim/neovim/releases/download/${NVIM_VERSION}/${asset}"
install_dir="/opt/nvim-${os}-${arch}"
target_bin="${install_dir}/bin/nvim"
link="/usr/local/bin/nvim"

# ── Idempotency short-circuit ─────────────────────────────────────────────
# If the pinned version is already on disk, skip the download and extract.
# Still repair the /usr/local/bin/nvim symlink if it drifted.
if [ -x "$target_bin" ]; then
    current="$("$target_bin" --version 2>/dev/null | head -n1 | awk '{print $2}')"
    if [ "$current" = "$NVIM_VERSION" ]; then
        log "neovim ${NVIM_VERSION} already installed at ${install_dir} — skipping download"
        if [ ! -L "$link" ] || [ "$(readlink "$link" 2>/dev/null)" != "$target_bin" ]; then
            log "Repairing symlink ${link} -> ${target_bin}"
            need_sudo ln -sfn "$target_bin" "$link"
        fi
        exit 0
    fi
    log "found neovim ${current:-unknown} at ${install_dir}, replacing with ${NVIM_VERSION}"
fi

# ── Download + extract ────────────────────────────────────────────────────
command -v curl >/dev/null 2>&1 || die "curl is required (install via system packages)"
command -v tar  >/dev/null 2>&1 || die "tar is required (install via system packages)"

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT INT TERM

log "Downloading ${url}"
curl -fL --proto '=https' --tlsv1.2 -o "${tmp}/${asset}" "$url" \
    || die "failed to download ${url}"

log "Extracting to /opt (sudo)"
need_sudo mkdir -p /opt
need_sudo rm -rf "$install_dir"
need_sudo tar -C /opt -xzf "${tmp}/${asset}"

log "Linking ${target_bin} -> ${link}"
need_sudo ln -sfn "$target_bin" "$link"

# Sanity check: the freshly installed binary reports the pinned version.
installed="$("$target_bin" --version 2>/dev/null | head -n1 | awk '{print $2}')"
if [ "$installed" != "$NVIM_VERSION" ]; then
    warn "installed nvim reports ${installed:-unknown}, expected ${NVIM_VERSION}"
fi
log "neovim ${installed:-?} installed"

# ── Cleanup: retire the old mise-managed neovim, if any ───────────────────
# Best-effort. mise's shim under ~/.local/share/mise/shims/nvim would
# otherwise shadow /usr/local/bin/nvim on the next `mise activate`.
if command -v mise >/dev/null 2>&1; then
    if mise ls neovim 2>/dev/null | grep -q .; then
        log "Removing stale mise-managed neovim..."
        mise uninstall neovim --all >/dev/null 2>&1 || warn "mise uninstall neovim failed (non-fatal)"
    fi
    rm -f "$HOME/.local/share/mise/shims/nvim" 2>/dev/null || true
fi
