# Docker Desktop WSL2 integration drops a symlink at
# /usr/share/zsh/vendor-completions/_docker that points into the
# /mnt/wsl/docker-desktop/... mount.  When Docker Desktop is not running
# the mount goes away and the symlink dangles, causing compinit to emit
#   compinit:527: no such file or directory: …/_docker
# which then breaks p10k instant prompt on subsequent logins.
# Drop the offending fpath entry in that edge case — Docker Desktop
# repopulates it automatically the next time it starts.
if [[ -L /usr/share/zsh/vendor-completions/_docker && ! -e /usr/share/zsh/vendor-completions/_docker ]]; then
  fpath=("${(@)fpath:#/usr/share/zsh/vendor-completions}")
fi

# OPENSPEC:START
# OpenSpec shell completions configuration
fpath=("$HOME/.oh-my-zsh/custom/completions" $fpath)
autoload -Uz compinit
compinit
# OPENSPEC:END

zmodload zsh/zprof

#
# General configuration
#

setopt interactive_comments
setopt prompt_subst
setopt auto_cd
setopt auto_pushd
setopt pushd_ignore_dups
setopt pushd_minus
setopt pushd_silent
setopt append_history
setopt inc_append_history
setopt extended_history
setopt hist_expire_dups_first
setopt hist_ignore_all_dups
setopt hist_ignore_dups
setopt hist_ignore_space
setopt share_history
setopt hup
setopt long_list_jobs
setopt notify
unsetopt nomatch

# ssh-agent — must be before p10k instant prompt (may need passphrase input)
source "$DOTFILES/modules/ssh-agent.zsh"

# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Activate mise for interactive use.  This hooks into zsh's precmd so
# project-local mise configs take effect on `cd`, and prepends the
# mise shim directory to PATH so every tool declared in
# ~/.config/mise/config.toml becomes callable.  Runs after ~/.local/bin
# is on PATH so the mise entrypoint is reachable.  Guarded with
# `command -v mise` so a machine that has not yet bootstrapped mise
# still loads a working shell.
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi

# oh-my-zsh. Aliases, functions, and tool blocks live below — see
# ~/.oh-my-zsh/templates/zshrc.zsh-template for the stock options this
# repo deliberately omits.
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="powerlevel10k/powerlevel10k"
plugins=(git fnm aws)
source $ZSH/oh-my-zsh.sh

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

source "$DOTFILES/modules/alias.zsh"
source "$DOTFILES/modules/functions.zsh"
source "$DOTFILES/modules/fzf.zsh"
source "$DOTFILES/modules/pkg-quarantine.zsh"

# if tofu is installed, load its completion
if command -v tofu >/dev/null 2>&1; then
  complete -C "$(command -v tofu)" tofu
fi

# fnm
FNM_PATH="$HOME/.local/share/fnm"
if [ -d "$FNM_PATH" ]; then
  export PATH="$FNM_PATH:$PATH"

  if command -v fnm >/dev/null 2>&1; then
    eval "$(fnm env --use-on-cd --shell zsh)"
  fi
fi

# if pnpm is installed, load its environment
if command -v pnpm >/dev/null 2>&1; then
  export PNPM_HOME="$HOME/.local/share/pnpm"
  # Only prepend PNPM_HOME to $PATH once pnpm has actually materialised
  # a global-bin directory there. Prepending a phantom dir otherwise
  # trips `mise doctor` on a fresh machine that has never installed a
  # global pnpm package.
  if [ -d "$PNPM_HOME" ]; then
    case ":$PATH:" in
      *":$PNPM_HOME:"*) ;;
      *) export PATH="$PNPM_HOME:$PATH" ;;
    esac
  fi

  # Create completion for pnpm if not already present
  if [ ! -f "$HOME/.zsh/completions/_pnpm" ]; then
    mkdir -p "$HOME/.zsh/completions"
    pnpm completion zsh > "$HOME/.zsh/completions/_pnpm"
  fi
fi

# .NET — only when a real dotnet binary lives under ~/.dotnet.
# Guarded on the binary (not the directory) because `~/.dotnet/corefx`
# can linger as cruft on a machine that has never actually installed
# dotnet, and prepending phantom paths here trips `mise doctor`.
if [ -x "$HOME/.dotnet/dotnet" ]; then
  export DOTNET_ROOT="$HOME/.dotnet"
  export PATH="$DOTNET_ROOT:$DOTNET_ROOT/tools:$PATH"
  export DOTNET_CLI_TELEMETRY_OPTOUT=1

  _dotnet_zsh_complete() {
    local completions=("$(dotnet complete "$words")")

    if [ -z "$completions" ]; then
      _arguments '*::arguments: _normal'
      return
    fi

    # This is not a variable assignment, don't remove spaces!
    _values = "${(ps:\n:)completions}"
  }

  compdef _dotnet_zsh_complete dotnet
fi

# bun — only when the standalone bun binary is installed under ~/.bun.
# bun is otherwise managed by mise, which exposes it through its shim
# directory without any PATH work here.
if [ -x "$HOME/.bun/bin/bun" ]; then
  export BUN_INSTALL="$HOME/.bun"
  export PATH="$BUN_INSTALL/bin:$PATH"
  [ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"
fi

# VSCode terminal shell integration
[[ "$TERM_PROGRAM" == "vscode" ]] && . "$(code --locate-shell-integration-path zsh)"

# peon-ping quick controls
alias peon="bash $HOME/.claude/hooks/peon-ping/peon.sh"
[ -f "$HOME/.claude/hooks/peon-ping/completions.bash" ] && source "$HOME/.claude/hooks/peon-ping/completions.bash"

