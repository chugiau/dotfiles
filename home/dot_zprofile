# Repo checkout (managed by chezmoi + mise; used by tooling only).
export DOTFILES_REPO="$HOME/.dotfiles"
# Runtime tree laid down by chezmoi — shell modules live here.
export DOTFILES="$HOME/.config/dotfiles"

export EDITOR="nvim"
export VISUAL="nvim"

# 自訂 PATH
export PATH="$HOME/bin:$HOME/.local/bin:$PATH"
export PATH="$DOTFILES_REPO/shellscripts:$PATH"

# 設定輸入法
export INPUT_METHOD=fcitx
export GTK_IM_MODULE=fcitx
export QT_IM_MODULE=fcitx
export XMODIFIERS=@im=fcitx
export SDL_IM_MODULE=icitx
export GLFW_IM_MODULE=ibus
fcitx5 --disable=wayland -d --verbose '*'=0

export BROWSER=brave.exe

# Claude Code
export ENABLE_LSP_TOOL=1

export DOTNET_CLI_TELEMETRY_OPTOUT=1

