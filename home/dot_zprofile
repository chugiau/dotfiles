# ~/.zprofile — sourced once per login shell, before ~/.zshrc.
#
# Login-scoped side effects and env whose cost shouldn't be paid per
# subshell. Pure env exports live in ~/.zshenv; interactive-only setup
# (prompt, completions, aliases, mise activate) lives in ~/.zshrc.

# Homebrew — detect macOS (/opt/homebrew, /usr/local) and Linuxbrew
# (/home/linuxbrew/.linuxbrew) layouts. Machines without brew skip the
# eval entirely. Lives in .zprofile per Homebrew's own install script:
# `brew shellenv` sets login-scoped PATH/MANPATH/INFOPATH/HOMEBREW_*
# that interactive children inherit, so running it per interactive
# subshell is wasted work.
for _brew in /opt/homebrew/bin/brew /usr/local/bin/brew /home/linuxbrew/.linuxbrew/bin/brew; do
    if [ -x "$_brew" ]; then
        eval "$("$_brew" shellenv zsh)"
        break
    fi
done
unset _brew

# mise shims for IDE/tool discovery (spec 036). Editors launched from
# desktop sessions or login-shell children often resolve tools from PATH
# without sourcing ~/.zshrc, so expose the shim directory from the login
# profile. This complements, not replaces, the interactive
# `mise activate zsh` hook in ~/.zshrc; arbitrary mise [env] values are
# loaded when the shimmed tool runs.
if command -v mise >/dev/null 2>&1; then
    eval "$(mise activate zsh --shims)"
fi
