#!/bin/sh
# Generate user-scope zsh completions for mise-managed CLIs.
#
# chezmoi re-runs this script whenever the mise config hash embedded
# below changes — so editing home/dot_config/mise/config.toml
# automatically refreshes completions on the next apply. The script
# itself is also content-addressed by chezmoi, so edits to the
# per-tool dispatch table also trigger a re-run.
#
# Output lands under $HOME/.local/share/zsh/completions/, which the
# completions.zsh module prepends to fpath ahead of system-scope
# completion dirs (/usr/share/zsh/{site-functions,vendor-completions}).
# That ordering is the spec's user > system precedence rule.
#
# Tools deliberately skipped (with reason inline below):
#   eza   — release tarball strips completions
#   node  — no native completion (npm has its own)
#   bun   — standalone-bun fallback already wired in dot_zshrc
#   direnv — no completion subcommand upstream
#
# completion-config-hash: {{ include "dot_config/mise/config.toml" | sha256sum }}

set -eu

log()  { printf '\033[0;34m[completions]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[completions]\033[0m %s\n' "$*" >&2; }

# mise lives under ~/.local/bin on a fresh-bootstrap chezmoi apply.
PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH"
export PATH

DEST="$HOME/.local/share/zsh/completions"
mkdir -p "$DEST"

# write_cmd <tool> <output-name> <shell-command-that-prints-completion>
# Runs the command, captures stdout, writes atomically, skips if the
# tool is not installed or the command fails.
write_cmd() {
    _tool=$1; _out=$2; _cmd=$3
    if ! command -v "$_tool" >/dev/null 2>&1; then
        log "skip $_tool (not on PATH)"
        return 0
    fi
    _tmp="$DEST/.$_out.tmp.$$"
    if sh -c "$_cmd" >"$_tmp" 2>/dev/null && [ -s "$_tmp" ]; then
        mv "$_tmp" "$DEST/$_out"
        log "wrote $_out (via: $_cmd)"
    else
        rm -f "$_tmp"
        warn "could not generate $_out via: $_cmd"
    fi
}

# write_file <tool> <output-name> <glob>
# Copies the first file matching <glob> in the mise install tree
# to $DEST/<output-name>. Glob-expanded by the shell here.
write_file() {
    _tool=$1; _out=$2; _glob=$3
    if ! command -v "$_tool" >/dev/null 2>&1; then
        log "skip $_tool (not on PATH)"
        return 0
    fi
    # Word-splitting on _glob is intentional — the shell expands it.
    # shellcheck disable=SC2086
    set -- $_glob
    if [ -e "$1" ] && [ -r "$1" ]; then
        cp -f "$1" "$DEST/$_out"
        log "wrote $_out (from: $1)"
    else
        warn "no completion file at: $_glob"
    fi
}

log "generating completions into $DEST"

# Tools whose release tarball ships a ready-to-use zsh completion file.
write_file bat _bat "$HOME/.local/share/mise/installs/bat/*/*/autocomplete/bat.zsh"
write_file rg  _rg  "$HOME/.local/share/mise/installs/ripgrep/*/*/complete/_rg"

# Tools that emit completions via a subcommand.
write_cmd lazygit _lazygit 'lazygit completion zsh'
write_cmd glow    _glow    'glow completion zsh'
write_cmd gh      _gh      'gh completion -s zsh'
write_cmd glab    _glab    'glab completion -s zsh'
write_cmd codex   _codex   'codex completion zsh'

log "done"
