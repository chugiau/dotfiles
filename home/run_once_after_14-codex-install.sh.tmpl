#!/bin/sh
# Install the Codex CLI via OpenAI's official installer.
#
# mise's bare `codex = "latest"` shorthand can resolve to either the aqua
# (static binary) or npm backend depending on mise version/platform — the
# same ambiguity spec 034 hit with eza on native Windows. Rather than keep
# depending on that resolution, POSIX hosts install Codex CLI directly with
# the official one-liner, mirroring how native Windows already does it
# (spec 040): no npm, no mise backend ambiguity.

set -eu

log()  { printf '\033[0;34m[codex-install]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[codex-install]\033[0m %s\n' "$*" >&2; }

if command -v codex >/dev/null 2>&1; then
    log "codex already installed — skipping"
    exit 0
fi

log "installing Codex CLI via the official installer"
if ! curl -fsSL https://chatgpt.com/codex/install.sh | sh; then
    warn "Codex CLI installer failed (non-fatal)"
fi
